---
import Layout from '../pages/layouts/Layout.astro';
import Header from '../components/Header.astro';
import ConversationGate from '../components/ConversationGate.jsx';
import { getTranslations } from '../strings/strings.js';
import PolisNet from '../lib/net';

const { conversation_id } = Astro.params;

// Validate conversation_id - reject common invalid requests
if (!conversation_id ||
    conversation_id === 'favicon.ico' ||
    conversation_id === 'robots.txt' ||
    conversation_id === 'sitemap.xml' ||
    conversation_id.includes('.') || // Reject any ID with file extensions
    conversation_id.length < 3) { // Reject very short IDs
  return Astro.redirect('/404');
}

let initialData;
let fetchError = null;

try {
  const apiParams = new URLSearchParams();
  if (conversation_id) {
    apiParams.append('conversation_id', conversation_id);
  }

  const xid = Astro.url.searchParams.get('xid');
  const x_name = Astro.url.searchParams.get('x_name');
  const x_profile_image_url = Astro.url.searchParams.get('x_profile_image_url');


  if (xid) {
    apiParams.append('xid', xid);
  }
  if (x_name) {
    apiParams.append('x_name', x_name);
  }
  if (x_profile_image_url) {
    apiParams.append('x_profile_image_url', x_profile_image_url);
  }


  // Retry once on 502 — handles startup race when server isn't ready yet
  try {
    initialData = await PolisNet.polisGet('/participationInit', { conversation_id, includePCA: false });
  } catch (firstErr: any) {
    if (firstErr?.status === 502) {
      await new Promise(r => setTimeout(r, 2000));
      initialData = await PolisNet.polisGet('/participationInit', { conversation_id, includePCA: false });
    } else {
      throw firstErr;
    }
  }
} catch (error: unknown) {
  console.error("Failed to fetch conversation data:", error);

  // Type-safe error handling
  const errorMessage = error instanceof Error ? error.message : String(error);
  const errorCause = error instanceof Error ? error.cause : undefined;
  const errorCode = errorCause && typeof errorCause === 'object' && 'code' in errorCause
    ? String(errorCause.code)
    : undefined;

  console.error("[DEBUG] Error details:", {
    message: errorMessage,
    cause: errorCause,
    code: errorCode,
    stack: error instanceof Error ? error.stack : undefined
  });

  fetchError = `Could not load this conversation. Error: ${errorMessage}. Please check the ID and try again.`;
}

const s = await getTranslations();

let surveyDetails, firstStatement, isConversationActive, authNeededToVote, authNeededToWrite;
if (initialData) {
  surveyDetails = {
    title: initialData.conversation.topic,
    description: initialData.conversation.description,
  };

  firstStatement = {
    tid: initialData.nextComment?.tid,
    txt: initialData.nextComment?.txt,
    remaining: initialData.nextComment?.remaining,
    author_name: initialData.nextComment?.author_name,
    author_avatar: initialData.nextComment?.author_avatar,
    author_xid: initialData.nextComment?.author_xid,
    author_is_blacksky_member: initialData.nextComment?.author_is_blacksky_member,
    author_is_funder: initialData.nextComment?.author_is_funder,
  };

  isConversationActive = initialData.conversation.is_active;
  authNeededToVote = initialData.conversation.auth_needed_to_vote || false;
  authNeededToWrite = initialData.conversation.auth_needed_to_write || false;
}

const hideHeader = Astro.url.searchParams.get('hide_header');
---
<Layout title={surveyDetails?.title ?? 'Loading Conversation...'}>
  {/* Handle JWT token from initial data on client side */}
  <script define:vars={{ initialData }}>
    if (initialData && initialData.auth && initialData.auth.token) {
      // Only store SSR token if there isn't already a conversation-specific token.
      // This prevents anonymous SSR tokens from overwriting xid tokens on refresh.
      import('../lib/auth').then(({ setJwtToken, getConversationToken }) => {
        const conversationId = initialData.conversation?.conversation_id;
        const existing = conversationId ? getConversationToken(conversationId) : null;
        if (!existing) {
          setJwtToken(initialData.auth.token);
        }
      });
    }
  </script>

  <div class="container">
    {hideHeader ? null : <Header />}

    {fetchError ? (
      <div class="error-message">
        <h2>Oops!</h2>
        <p>{fetchError}</p>
      </div>
    ) : initialData ? (
      <>
        <h1>
          {surveyDetails?.title}
          {!isConversationActive && <span class="closed-badge">closed</span>}
        </h1>
        <p class="description" set:html={surveyDetails?.description}></p>

        {isConversationActive ? (
          <ConversationGate
            client:load
            conversation_id={initialData.conversation.conversation_id}
            initialStatement={firstStatement}
            authNeededToVote={authNeededToVote}
            authNeededToWrite={authNeededToWrite}
            s={s}
            introHtml={s.participantHelpWelcomeText}
          />
        ) : (
          <div class="footer-spacer"></div>
        )}
      </>
    ) : (
      <p>Loading...</p>
    )}

    <div style="margin-top: 3rem; text-align: center;">
      <a href="/home">
      <svg class="blacksky-logo-footer" width="55" height="55" viewBox="0 0 135 135" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="135" height="135" rx="5" fill="#8B8BFF"/>
        <path d="M69.6357 78.0176C69.6357 81.5309 72.4837 84.3799 75.9971 84.3799H88.1396V65.875H88.1416V106.961H88.1396V88.7705H75.9971C72.4837 88.7705 69.6358 91.6185 69.6357 95.1318V106.961H65.5596V95.1318C65.5595 91.6186 62.7115 88.7706 59.1982 88.7705H47.0547V84.3799H59.1982C62.7115 84.3798 65.5596 81.5309 65.5596 78.0176V65.875H69.6357V78.0176Z" fill="black"/>
        <path d="M76.9208 39.7337C73.4148 43.1335 73.4147 48.6457 76.9208 52.0456L84 58.9102L80.8137 62L73.7345 55.1353C70.2284 51.7355 64.5439 51.7355 61.0378 55.1353L54.1863 61.7792L51.2275 58.91L58.079 52.2661C61.585 48.8663 61.585 43.3541 58.079 39.9542L51 33.0898L54.1863 30L61.2655 36.8647C64.7716 40.2645 70.4561 40.2645 73.9622 36.8647L81.0414 30L84 32.869L76.9208 39.7337Z" fill="black"/>
        <path d="M47.3226 53.5452C46.0666 58.2418 48.8483 63.0695 53.5357 64.3279L63 66.869L61.8586 71.137L52.3946 68.5961C47.7073 67.3376 42.8892 70.1248 41.6333 74.8215L39.1788 84L35.223 82.9379L37.6774 73.7598C38.9334 69.0631 36.1517 64.2355 31.4643 62.977L22 60.436L23.1414 56.1676L32.6058 58.7086C37.2931 59.9671 42.1111 57.1798 43.3671 52.4832L45.9031 43L49.8586 44.062L47.3226 53.5452Z" fill="black"/>
        <path d="M91.6329 52.4832C92.8889 57.1798 97.707 59.9671 102.394 58.7087L111.859 56.1676L113 60.4357L103.536 62.9767C98.8483 64.2352 96.0666 69.0629 97.3226 73.7595L99.777 82.938L95.8216 84L93.3672 74.8218C92.1112 70.1251 87.2932 67.3379 82.6058 68.5964L73.1414 71.1374L72 66.869L81.4643 64.328C86.1517 63.0695 88.9334 58.2419 87.6774 53.5452L85.1415 44.062L89.097 43L91.6329 52.4832Z" fill="black"/>
      </svg>
      </a>
      <div class="footer-links">
        <a href="/privacy" target="_blank" rel="noopener noreferrer">{s.privacy}</a>
        <a href="/tos" target="_blank" rel="noopener noreferrer">{s.TOS}</a>
      </div>
    </div>
  </div>
</Layout>
